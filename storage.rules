rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Profile pictures: <uid>.jpg — only that user can upload/replace or
    // delete their own; anyone signed in can view (needed to show a
    // photo on a broadcast SOS card from someone else).
    match /profile_pictures/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && fileName == request.auth.uid + '.jpg'
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
