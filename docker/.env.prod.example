# ResQNet — production environment template for docker-compose.reference.yml.
#
# Copy to .env.prod next to the real compose file on the VPS
# (/opt/resqnet/docker/.env.prod), fill in real values, then:
#   chmod 600 /opt/resqnet/docker/.env.prod
# NEVER commit the filled-in version to git.

# --- Runtime ---
NODE_ENV=production
# Host port the api container is reachable on (127.0.0.1:<this>:3000
# inside docker-compose.reference.yml). Pick from your confirmed free
# port block — do not assume 3300 is free without checking first.
RESQNET_API_PORT=3300
PUBLIC_BASE_URL=http://<vps-ip>:3300
CORS_ORIGINS=

# --- Deployed image (Phase 18) ---
# The exact image backend-ci.yml built, tested, and pushed to GHCR —
# always a commit-SHA tag, NEVER :latest (see docker-compose.reference.yml's
# api service comment). deploy.sh sets/overrides this per invocation; the
# value here is just a documented placeholder for a first manual run.
# Requires <github-org>/<repo> — still an open item, see docs/PLAN.md's
# "Still open" list — do not guess it.
RESQNET_API_IMAGE=ghcr.io/<github-org>/<repo>/resqnet-api:<commit-sha>

# --- PostgreSQL ---
# These three feed BOTH the official postgres image (which requires
# exactly POSTGRES_DB/POSTGRES_USER/POSTGRES_PASSWORD) and, via the PG_*
# vars below, the ResQNet API container — keep them in sync, they are not
# independent values.
POSTGRES_DB=resqnet
POSTGRES_USER=resqnet_app
POSTGRES_PASSWORD=change_me_to_a_long_random_value

PG_HOST=resqnet-db
PG_PORT=5432
PG_USER=resqnet_app
PG_PASSWORD=change_me_to_a_long_random_value
PG_DATABASE=resqnet
PG_POOL_MAX=10
PG_SSL=false

# --- Google Sign-In V2 ---
# Web OAuth client ID (client_type 3) from android/app/google-services.json
# in the ResQNet repo — already exists, not a new value to create.
GOOGLE_OAUTH_CLIENT_ID=427023478978-bgk7b0vm2krk7d0qm2ssbajj46s7t6e1.apps.googleusercontent.com

# --- ResQNet session tokens ---
# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# --- Employee Portal session tokens (Phase 15) ---
# Deliberately SEPARATE secrets from JWT_ACCESS_SECRET/JWT_REFRESH_SECRET
# above — employees are a separate identity space from consumer users.
# Generate each with: openssl rand -base64 48
EMPLOYEE_JWT_ACCESS_SECRET=
EMPLOYEE_JWT_REFRESH_SECRET=
EMPLOYEE_JWT_ACCESS_TTL_MINUTES=15
EMPLOYEE_JWT_REFRESH_TTL_DAYS=30

# --- MinIO (Phase 6) ---
# MINIO_ROOT_USER/MINIO_ROOT_PASSWORD are the official minio image's own
# required bootstrap variables. MINIO_ACCESS_KEY/MINIO_SECRET_KEY are what
# the API container uses to connect — keep all four in sync (same values),
# same pairing convention already used for POSTGRES_*/PG_* above.
MINIO_ROOT_USER=resqnet_minio
MINIO_ROOT_PASSWORD=change_me_to_a_long_random_value
MINIO_ACCESS_KEY=resqnet_minio
MINIO_SECRET_KEY=change_me_to_a_long_random_value
MINIO_ENDPOINT=resqnet-minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_PROFILE_IMAGES_BUCKET=resqnet-profile-images

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
SOS_RATE_LIMIT_WINDOW_MS=60000
SOS_RATE_LIMIT_MAX=5
REPORT_RATE_LIMIT_WINDOW_MS=60000
REPORT_RATE_LIMIT_MAX=10

# --- Logging ---
LOG_LEVEL=info

# --- Reverse proxy ---
# 0 for now (no nginx in front yet during direct-IP testing); set to 1
# once nginx is added in front of this (Phase 18).
TRUSTED_PROXY_HOPS=0

# --- WebSocket ---
WS_PATH=/ws
