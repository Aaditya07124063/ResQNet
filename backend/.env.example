# ResQNet backend — environment configuration template.
# Copy to .env for local development. NEVER commit the real .env file.
# On the VPS, real values live only in /opt/resqnet/.env.prod (chmod 600),
# provisioned directly by the host operator — never templated by CI.

# --- Runtime ---
NODE_ENV=development
# development | staging | production
PORT=4000
HOST=0.0.0.0
PUBLIC_BASE_URL=http://localhost:4000

# --- CORS ---
# Comma-separated list of allowed origins. No wildcard "*" in production.
CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL ---
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=resqnet_app
PG_PASSWORD=change_me
PG_DATABASE=resqnet
PG_POOL_MAX=10
PG_SSL=false

# --- Google Sign-In V2 ---
# OAuth 2.0 Web client ID from Google Cloud Console (Credentials -> OAuth
# client IDs -> Web application), used server-side to verify ID tokens sent
# by the Flutter app. Confirm current setup steps against Google's live
# docs before relying on this — see docs/AUDIT.md open item on Google
# Sign-In V2.
GOOGLE_OAUTH_CLIENT_ID=

# --- ResQNet session tokens (JWT access + refresh) ---
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# --- Employee Portal session tokens (Phase 15) ---
# Deliberately SEPARATE secrets from JWT_ACCESS_SECRET/JWT_REFRESH_SECRET
# above — employees are a separate identity space from consumer users.
# Generate with: openssl rand -base64 48
EMPLOYEE_JWT_ACCESS_SECRET=
EMPLOYEE_JWT_REFRESH_SECRET=
EMPLOYEE_JWT_ACCESS_TTL_MINUTES=15
EMPLOYEE_JWT_REFRESH_TTL_DAYS=30

# --- Provider-credential encryption ---
# AES-256-GCM key (32 raw bytes, base64-encoded) used to encrypt
# email_providers/sms_providers credential blobs before they touch
# PostgreSQL. Generate with: openssl rand -base64 32
PROVIDER_CREDENTIALS_ENCRYPTION_KEY=

# --- MinIO (Phase 6 — required; storageService.ts fails to start without these) ---
# MINIO_ACCESS_KEY/MINIO_SECRET_KEY authenticate the backend to MinIO and
# should be the SAME values as the MinIO container's own
# MINIO_ROOT_USER/MINIO_ROOT_PASSWORD (see docker/.env.prod.example) —
# mirrors the existing POSTGRES_*/PG_* pairing already used for Postgres,
# not two independent credential pairs.
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=resqnet_minio
MINIO_SECRET_KEY=change_me_local_dev_only
MINIO_PROFILE_IMAGES_BUCKET=resqnet-profile-images

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
SOS_RATE_LIMIT_WINDOW_MS=60000
SOS_RATE_LIMIT_MAX=5
REPORT_RATE_LIMIT_WINDOW_MS=60000
REPORT_RATE_LIMIT_MAX=10
EMPLOYEE_AUTH_RATE_LIMIT_WINDOW_MS=60000
EMPLOYEE_AUTH_RATE_LIMIT_MAX=10

# --- Logging ---
LOG_LEVEL=info
# debug | info | warn | error

# --- Reverse proxy ---
# Number of trusted proxy hops in front of this process (nginx on the same
# VPS = 1). Needed so req.ip / rate limiting see the real client IP.
TRUSTED_PROXY_HOPS=1

# --- WebSocket ---
WS_PATH=/ws
