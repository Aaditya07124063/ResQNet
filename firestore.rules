rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user's own profile (name, blood group, address, country/state/
    // city, etc.) — only that user can read or write it.
    match /user_profiles/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Personal emergency contacts (parents/relatives) saved under the
      // profile — same owner-only access.
      match /trusted_contacts/{contactId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Each user's own SOS/mesh message history.
    match /sos_history/{uid}/messages/{messageId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // SOS broadcasts: any signed-in user can create one (to alert other
    // ResQNet users nearby); only the Cloud Function (Admin SDK, bypasses
    // these rules) reads them to fan out push notifications, so no client
    // read access is needed.
    match /sos_broadcasts/{alertId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if false;
    }

    // SOS dispatch records (police/disaster-management + trusted-contact
    // routing metadata for one SOS). Same pattern: client only ever
    // creates; the Cloud Function (Admin SDK) is the only reader.
    match /sos_dispatch/{alertId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if false;
    }

    // FCM push token per user — only that user writes their own token;
    // Cloud Functions (Admin SDK) read all tokens to fan out pushes.
    match /user_tokens/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Local seismic-candidate reports (EarthquakeCorrelationService).
    // Client only ever creates one per detection; the correlation Cloud
    // Function (Admin SDK) does the multi-device clustering and is the
    // only reader/updater (it writes back corroboratingDeviceCount).
    match /seismic_events/{eventId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if false;
    }

    // Everything else: locked down by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
